<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:lw="/lib/livewall">
  <l:layout title="${it.displayName}">
    <st:include page="sidepanel.jelly" />
    <l:main-panel>
      <st:adjunct includes="io.jenkins.plugins.livewall.wall" />

      <!-- The row of view tabs. A custom view has to render this itself: core draws it from
           View/main.jelly, which this view replaces wholesale, so without it there is no way to
           navigate to another view from here. Mirrors what core does, including the two tab bar
           flavours. -->
      <j:set var="views" value="${it.owner.views}" />
      <j:set var="currentView" value="${it}" />
      <j:choose>
        <j:when test="${it.isMyViewsProperty()}">
          <st:include it="${it.owner.viewsTabBar}" page="viewTabs" />
        </j:when>
        <j:otherwise>
          <st:include it="${it.owner.userViewsTabBar}" page="viewTabs" />
        </j:otherwise>
      </j:choose>

      <!-- Try a look against your real jobs before committing to it. Nothing here is saved: the
           wall a television loads comes from the view configuration, or from URL parameters. -->
      <div class="lw-preview-bar">
        <button type="button" class="jenkins-button jenkins-button--primary" data-lw-action="fullscreen">
          ${%Full screen}
        </button>
        <a class="jenkins-button" href="${rootURL}/${it.viewUrl}wall">${%Open kiosk page}</a>

        <label class="lw-field">
          <span class="lw-field__label">${%Palette}</span>
          <div class="jenkins-select">
            <select class="jenkins-select__input" data-lw-preview="palette">
              <j:forEach var="option" items="${it.paletteOptions}">
                <option value="${option.id}">${option.shortName}</option>
              </j:forEach>
            </select>
          </div>
        </label>

        <label class="lw-field">
          <span class="lw-field__label">${%Shape}</span>
          <div class="jenkins-select">
            <select class="jenkins-select__input" data-lw-preview="shape">
              <j:forEach var="option" items="${it.shapeOptions}">
                <option value="${option.id}">${option.shortName}</option>
              </j:forEach>
            </select>
          </div>
        </label>

        <label class="lw-field">
          <span class="lw-field__label">${%Animation}</span>
          <div class="jenkins-select">
            <select class="jenkins-select__input" data-lw-preview="animation">
              <j:forEach var="option" items="${it.animationOptions}">
                <option value="${option.id}">${option.shortName}</option>
              </j:forEach>
            </select>
          </div>
        </label>

        <label class="lw-field">
          <span class="lw-field__label">${%Packing}</span>
          <div class="jenkins-select">
            <select class="jenkins-select__input" data-lw-preview="packing">
              <j:forEach var="option" items="${it.packingOptions}">
                <option value="${option.id}">${option.shortName}</option>
              </j:forEach>
            </select>
          </div>
        </label>

        <label class="lw-field">
          <span class="lw-field__label">${%Order}</span>
          <div class="jenkins-select">
            <select class="jenkins-select__input" data-lw-preview="sortBy">
              <j:forEach var="option" items="${it.sortByOptions}">
                <option value="${option.id}">${option.shortName}</option>
              </j:forEach>
            </select>
          </div>
        </label>

        <label class="lw-field lw-field--slider">
          <span class="lw-field__label">${%Gap} <output data-lw-output="gap">0</output>px</span>
          <input type="range" min="0" max="48" step="1" data-lw-preview="gap" />
        </label>

        <label class="lw-field lw-field--slider">
          <span class="lw-field__label">${%Separator} <output data-lw-output="seam">2</output>px</span>
          <input type="range" min="0" max="12" step="1" data-lw-preview="seam" />
        </label>

        <span class="lw-hint">${%preview.hint}</span>
      </div>

      <lw:wall variant="embedded" />
    </l:main-panel>
  </l:layout>
</j:jelly>
