<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2221.va_045130417c9</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>live-wall</artifactId>
  <version>${changelist}</version>
  <packaging>hpi</packaging>

  <name>Live Wall</name>
  <description>Full-screen, high-contrast radiator of Jenkins job status for office TVs and big monitors. No pagination, no clutter: just job names, vivid colours and motion.</description>
  <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/${gitHubRepo}.git</connection>
    <developerConnection>scm:git:git@github.com:${gitHubRepo}.git</developerConnection>
    <tag>${scmTag}</tag>
    <url>https://github.com/jenkinsci/${project.artifactId}-plugin</url>
  </scm>

  <properties>
    <changelist>999999-SNAPSHOT</changelist>
    <gitHubRepo>jenkinsci/live-wall-plugin</gitHubRepo>

    <!-- Guard rails required for hosting. Each turns a class of accident into a build failure:
         bundling a third-party library by mistake, keeping a dependency override that a newer BOM
         made redundant, reaching for JUnit 4, or using a deprecated Stapler or commons-lang 2 API
         that Jenkins core already provides a replacement for. -->
    <hpi.strictBundledArtifacts>true</hpi.strictBundledArtifacts>
    <banObsoleteDependencyOverrides.skip>false</banObsoleteDependencyOverrides.skip>
    <ban-junit4-imports.skip>false</ban-junit4-imports.skip>
    <ban-deprecated-stapler.skip>false</ban-deprecated-stapler.skip>
    <ban-commons-lang-2.skip>false</ban-commons-lang-2.skip>

    <!-- The parent pom skips the formatting check by default, which meant `mvn clean verify` was
         green on a tree spotless did not consider formatted, and three documents here claimed
         formatting was part of the gate when nothing was enforcing it. Either the claim or the
         configuration had to change; this is the configuration changing. `mvn spotless:apply`
         fixes anything it complains about. -->
    <spotless.check.skip>false</spotless.check.skip>

    <!-- Jenkins baseline. Keep roughly one year behind the newest LTS so the
         plugin installs on the controllers people actually run. -->
    <jenkins.baseline>2.555</jenkins.baseline>
    <jenkins.version>${jenkins.baseline}.3</jenkins.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.jenkins.tools.bom</groupId>
        <artifactId>bom-${jenkins.baseline}.x</artifactId>
        <version>7002.v028a_3607ddc8</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>

  <!-- No plugin dependencies: everything the wall needs is in Jenkins core. The BOM above is
       imported anyway so that any future dependency picks a version consistent with the baseline. -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- A wall never talks to an agent, so the test controllers do not need a listener.
                 Turning it off also avoids a shutdown hang on machines whose hostname resolves to
                 an address they cannot connect back to, such as a laptop on a VPN. -->
            <jenkins.model.Jenkins.slaveAgentPort>-1</jenkins.model.Jenkins.slaveAgentPort>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
